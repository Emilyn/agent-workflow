# Copy to .env (never commit it).

# Encrypts the Anthropic API keys stored in the database. 32 random bytes.
#   openssl rand -base64 32
# Keep it safe: if you lose it, stored API keys can't be decrypted (people reconnect them).
SECRET_KEY=

# Database password used by docker compose. Change it for anything but local use.
POSTGRES_PASSWORD=agentworkflow

# Turn on when the app is served over HTTPS, so the sign-in cookie is only sent securely.
COOKIE_SECURE=false

# Turn on when running behind a reverse proxy or load balancer that sets X-Forwarded-For
# (rate limits then use the real client address).
TRUST_PROXY=false

# Set to false to stop new sign-ups (existing users and invite links still work only for existing accounts).
ALLOW_SIGNUP=true

# Optional: an Anthropic API key used by workspaces that haven't connected their own.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
